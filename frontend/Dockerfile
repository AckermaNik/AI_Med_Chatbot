FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY index.html vite.config.js eslint.config.js ./
COPY public ./public
COPY src ./src

RUN npm run build

FROM nginx:1.27-alpine

# Replace Nginx's default site configuration with ours. This configuration
# serves the React app and forwards /api requests to the backend container.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the production files generated by "npm run build" into Nginx's
# standard web root, where Nginx serves them to the browser.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
