# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- database ---
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+asyncpg://medai:medai@localhost:5433/medai

# --- gemini ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- scoring hyperparameters (see docs/PLAN.md section 5) ---
# Defaults are starting points, tuned later against the eval set.
SCORING_MU=2.0
SCORING_MMR_LAMBDA=0.7
SCORING_MMR_POOL=20
SCORING_TOP_K=5
SCORING_MIN_SCORE=0.15
SCORING_CONFIDENT_MARGIN=0.15
SCORING_MAX_FOLLOWUPS=3

# --- matcher thresholds (see docs/PLAN.md section 3) ---
MATCH_TRIGRAM_THRESHOLD=0.45
MATCH_EMBEDDING_THRESHOLD=0.60
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
